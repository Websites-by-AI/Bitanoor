# Bitanoor Electric - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=@bitanoor_elec_bot
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string_here

# Bale Bot Configuration (optional)
BALE_BOT_TOKEN=your_bale_bot_token_here
BALE_WEBHOOK_SECRET=your_random_secret_string_here

# Website Configuration
WEBSITE_URL=https://bitanoor-electric.pages.dev
SITE_NAME=بیتانور الکتریک
SITE_DESCRIPTION=سامانه تولیدکنندگان و تامین‌کنندگان چراغ‌های برقی ایران

# Database Configuration
# For Cloudflare D1:
DATABASE_TYPE=d1
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
D1_DATABASE_ID=your_d1_database_id
D1_DATABASE_NAME=bitanoor_electric

# For local development (SQLite):
# DATABASE_TYPE=sqlite
# DATABASE_URL=sqlite://./local.db

# Admin Configuration
ADMIN_PHONE=09120000001
ADMIN_PASSWORD=demo123

# Demo Accounts (for testing)
DEMO_ADMIN_PHONE=09120000001
DEMO_SELLER_PHONE=09123333333
DEMO_BUYER_PHONE=09121111111
DEMO_CUSTOMER_PHONE=09125555555
DEMO_MARKETER_PHONE=09128888888
DEMO_PASSWORD=demo123

# API Configuration
API_BASE_URL=https://bitanoor-electric.pages.dev/api

# Cloudflare Pages
NEXT_PUBLIC_SITE_URL=https://bitanoor-electric.pages.dev
